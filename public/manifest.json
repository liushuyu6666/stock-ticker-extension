{
  "manifest_version": 3,
  "name": "Stock Ticker",
  "version": "0.1.0",
  "description": "A compact market-ticker bar: ticker, current/target price, and a one-year sparkline.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://query1.finance.yahoo.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_page": "config.html",
  "action": {
    "default_title": "Stock Ticker options"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
